namespace ledgera_engine {};

[Error]
enum LedgeraEngineError {
    "Validation",
    "Storage",
};

dictionary RecordFilterDto {
    string? start_date;
    string? end_date;
    i64? wallet_id;
    string? record_type;
};

dictionary CreateRecordRequest {
    string record_type;
    string date;
    i64 wallet_id;
    string amount_original;
    string currency;
    string rate_at_operation;
    string amount_base;
    string category;
    string description;
    sequence<string> tags;
};

dictionary UpdateRecordRequest {
    string record_type;
    string date;
    i64 wallet_id;
    string amount_original;
    string currency;
    string rate_at_operation;
    string amount_base;
    string category;
    string description;
    sequence<string> tags;
};

dictionary CreateTransferRequest {
    i64 from_wallet_id;
    i64 to_wallet_id;
    string date;
    string amount;
    string currency;
    string description;
    string commission_amount;
    string commission_currency;
};

dictionary CreateTransferResult {
    i64 transfer_id;
};

dictionary UpdateTransferRequest {
    i64 from_wallet_id;
    i64 to_wallet_id;
    string date;
    string amount;
    string currency;
    string description;
};

dictionary UpdateTransferResult {
    i64 transfer_id;
};

dictionary CreateWalletRequest {
    string name;
    string currency;
    string initial_balance;
    boolean allow_negative;
};

dictionary CreateDebtRequest {
    string kind;
    string contact_name;
    i64 wallet_id;
    string amount;
    string currency;
    string created_at;
    string description;
};

dictionary RegisterDebtPaymentRequest {
    i64 debt_id;
    i64? wallet_id;
    string amount;
    string payment_date;
    string description;
};

dictionary CreateMandatoryTemplateRequest {
    i64 wallet_id;
    string amount_original;
    string currency;
    string rate_at_operation;
    string amount_base;
    string category;
    string description;
    string period;
    string date;
};

dictionary UpdateMandatoryTemplateRequest {
    i64 wallet_id;
    string amount_base;
    string period;
    string date;
};

dictionary CreateBudgetRequest {
    string category;
    string scope_type;
    string scope_value;
    string start_date;
    string end_date;
    string limit_base;
    boolean include_mandatory;
};

dictionary BudgetDto {
    i64 id;
    string category;
    string scope_type;
    string scope_value;
    string start_date;
    string end_date;
    string limit_base;
    i64 limit_base_minor;
    boolean include_mandatory;
};

dictionary BudgetResultDto {
    BudgetDto budget;
    string spent_base;
    i64 spent_minor;
    string remaining_base;
    double usage_pct;
    double time_pct;
    string status;
    string pace_status;
    string? forecast_remaining_base;
    string? forecast_delta_base;
    i64? forecast_days_left;
    string? forecast_status_key;
    string? forecast_status_params;
};

dictionary FullBackupResultDto {
    string path;
    i64 imported_rows;
    i64 budget_rows;
};

dictionary AddMandatoryToRecordsRequest {
    i64 template_id;
    string date;
    i64 wallet_id;
};

dictionary WalletDeleteResultDto {
    i64 wallet_id;
    string action;
};

dictionary OperationDeleteResultDto {
    i64 deleted_records;
    i64 deleted_transfers;
    i64 deleted_debt_linked_records;
    i64 skipped_records;
};

dictionary OperationImportResultDto {
    i64 imported;
    i64 skipped;
    sequence<string> errors;
    boolean dry_run;
    boolean blocking_errors;
};

dictionary OperationExportResultDto {
    i64 exported_rows;
    string path;
};

dictionary OperationSuggestionsDto {
    sequence<string> tags;
    sequence<string> income_categories;
    sequence<string> expense_categories;
    sequence<string> descriptions;
    sequence<string> income_descriptions;
    sequence<string> expense_descriptions;
};

dictionary TagColorDto {
    string name;
    string color;
};

dictionary TagColorAssignment {
    string name;
    string color;
};

dictionary MandatoryImportResultDto {
    i64 imported;
    i64 skipped;
    sequence<string> errors;
    boolean dry_run;
    boolean blocking_errors;
};

dictionary MandatoryExportResultDto {
    i64 exported_rows;
    string path;
};

dictionary AuditFindingDto {
    string check;
    string severity;
    string message;
    string entity;
};

dictionary RecordDto {
    i64 id;
    string record_type;
    string date;
    i64 wallet_id;
    i64? transfer_id;
    i64? related_debt_id;
    string amount_original;
    string currency;
    string rate_at_operation;
    string amount_base;
    string category;
    string description;
    sequence<string> tags;
};

dictionary WalletDto {
    i64 id;
    string name;
    string currency;
    string initial_balance;
    boolean system;
    boolean allow_negative;
    boolean is_active;
};

dictionary TransferDto {
    i64 id;
    i64 from_wallet_id;
    i64 to_wallet_id;
    string date;
    string amount_original;
    string currency;
    string rate_at_operation;
    string amount_base;
    string description;
};

dictionary DebtDto {
    i64 id;
    string contact_name;
    string kind;
    string total_amount;
    string remaining_amount;
    string currency;
    string interest_rate;
    string status;
    string created_at;
    string? closed_at;
};

dictionary DebtPaymentDto {
    i64 id;
    i64 debt_id;
    i64? record_id;
    string operation_type;
    string principal_paid;
    boolean is_write_off;
    string payment_date;
};

dictionary MandatoryTemplateDto {
    i64 id;
    i64 wallet_id;
    string amount_original;
    string currency;
    string rate_at_operation;
    string amount_base;
    string category;
    string description;
    string period;
    string date;
    boolean auto_pay;
};

dictionary MandatoryAutoPayResultDto {
    sequence<RecordDto> created_records;
};

dictionary WalletBalanceDto {
    i64 wallet_id;
    string name;
    string currency;
    string balance;
};

dictionary EngineStatusDto {
    boolean ok;
    string db_path;
    string message;
};

dictionary ReportFiltersDto {
    i64? wallet_id;
    string? period_start;
    string? period_end;
    string category;
    string tag;
    string tag_mode;
    string totals_mode;
    boolean group_by_category;
};

dictionary ReportSummaryDto {
    double net_worth_fixed;
    double net_worth_current;
    double initial_balance;
    double records_total_fixed;
    double records_total_current;
    double final_balance_fixed;
    double final_balance_current;
    double fx_difference;
    i64 records_count;
    string balance_label;
    string active_tag;
};

dictionary ReportOperationRowDto {
    string date;
    string type_label;
    string kind;
    string category;
    string tags_text;
    double amount_base;
    double amount_current;
    string description;
};

dictionary ReportMonthlyRowDto {
    string month;
    double income;
    double expenses;
    double income_current;
    double expenses_current;
};

dictionary ReportCategoryRowDto {
    string category;
    i64 operations_count;
    double total_base;
    double total_current;
};

dictionary ReportTagRowDto {
    string tag;
    i64 operations_count;
    double total_base;
    double total_current;
};

dictionary ReportDebtRowDto {
    string contact_name;
    string kind;
    string status;
    string created_at;
    string? closed_at;
    string currency;
    double total_amount;
    double remaining_amount;
    double settled_amount;
    double progress_percent;
};

dictionary ReportResultDto {
    string title;
    string base_currency;
    string display_currency;
    ReportFiltersDto filters;
    ReportSummaryDto summary;
    sequence<ReportOperationRowDto> operations;
    sequence<ReportMonthlyRowDto> monthly;
    sequence<ReportCategoryRowDto> categories;
    sequence<ReportTagRowDto> tags;
    sequence<ReportDebtRowDto> debts;
};

dictionary ReportExportResultDto {
    i64 exported_rows;
    string path;
};

interface LedgeraEngine {
    constructor(string db_path);

    EngineStatusDto engine_status();
    [Throws=LedgeraEngineError]
    ReportResultDto generate_report(ReportFiltersDto filters);
    [Throws=LedgeraEngineError]
    ReportExportResultDto export_report_csv(ReportFiltersDto filters, string path);
    [Throws=LedgeraEngineError]
    ReportExportResultDto export_report_xlsx(ReportFiltersDto filters, string path);
    [Throws=LedgeraEngineError]
    ReportExportResultDto export_report_pdf(ReportFiltersDto filters, string path);
    [Throws=LedgeraEngineError]
    string base_currency();
    [Throws=LedgeraEngineError]
    sequence<RecordDto> list_records(RecordFilterDto filter);
    [Throws=LedgeraEngineError]
    RecordDto? get_record(i64 record_id);
    [Throws=LedgeraEngineError]
    RecordDto create_record(CreateRecordRequest request);
    [Throws=LedgeraEngineError]
    RecordDto create_record_with_tag_colors(CreateRecordRequest request, sequence<TagColorAssignment> tag_colors);
    [Throws=LedgeraEngineError]
    RecordDto update_record(i64 record_id, UpdateRecordRequest request);
    [Throws=LedgeraEngineError]
    RecordDto update_record_with_tag_colors(i64 record_id, UpdateRecordRequest request, sequence<TagColorAssignment> tag_colors);
    [Throws=LedgeraEngineError]
    boolean delete_record(i64 record_id);
    [Throws=LedgeraEngineError]
    CreateTransferResult create_transfer(CreateTransferRequest request);
    [Throws=LedgeraEngineError]
    TransferDto? get_transfer(i64 transfer_id);
    [Throws=LedgeraEngineError]
    UpdateTransferResult update_transfer(i64 transfer_id, UpdateTransferRequest request);
    [Throws=LedgeraEngineError]
    boolean delete_transfer(i64 transfer_id);
    [Throws=LedgeraEngineError]
    OperationDeleteResultDto delete_all_operations();
    [Throws=LedgeraEngineError]
    OperationDeleteResultDto delete_operations_selection(sequence<i64> record_ids, sequence<i64> transfer_ids);
    [Throws=LedgeraEngineError]
    OperationImportResultDto preview_import_records_csv(string path);
    [Throws=LedgeraEngineError]
    OperationImportResultDto import_records_csv(string path);
    [Throws=LedgeraEngineError]
    OperationExportResultDto export_records_csv(string path);
    [Throws=LedgeraEngineError]
    OperationImportResultDto preview_import_records_xlsx(string path);
    [Throws=LedgeraEngineError]
    OperationImportResultDto import_records_xlsx(string path);
    [Throws=LedgeraEngineError]
    OperationExportResultDto export_records_xlsx(string path);
    [Throws=LedgeraEngineError]
    sequence<string> list_tags();
    [Throws=LedgeraEngineError]
    sequence<string> list_categories(string record_type);
    [Throws=LedgeraEngineError]
    sequence<string> list_record_descriptions(string? record_type);
    [Throws=LedgeraEngineError]
    OperationSuggestionsDto operation_suggestions();
    [Throws=LedgeraEngineError]
    sequence<TagColorDto> list_tag_colors();
    sequence<string> tag_color_palette();
    [Throws=LedgeraEngineError]
    void normalize_tag_colors();
    [Throws=LedgeraEngineError]
    sequence<WalletDto> list_wallets();
    [Throws=LedgeraEngineError]
    WalletDto create_wallet(CreateWalletRequest request);
    [Throws=LedgeraEngineError]
    WalletDeleteResultDto delete_wallet(i64 wallet_id);
    [Throws=LedgeraEngineError]
    sequence<BudgetDto> list_budgets();
    [Throws=LedgeraEngineError]
    sequence<BudgetResultDto> list_budget_results(string? today);
    [Throws=LedgeraEngineError]
    BudgetDto create_budget(CreateBudgetRequest request);
    [Throws=LedgeraEngineError]
    BudgetDto update_budget_limit(i64 budget_id, string limit_base);
    [Throws=LedgeraEngineError]
    boolean delete_budget(i64 budget_id);
    [Throws=LedgeraEngineError]
    FullBackupResultDto preview_full_backup_json(string path);
    [Throws=LedgeraEngineError]
    FullBackupResultDto import_full_backup_json(string path);
    [Throws=LedgeraEngineError]
    FullBackupResultDto export_full_backup_json(string path);
    [Throws=LedgeraEngineError]
    sequence<DebtDto> list_debts();
    [Throws=LedgeraEngineError]
    sequence<DebtPaymentDto> list_debt_payments(i64 debt_id);
    [Throws=LedgeraEngineError]
    DebtDto create_debt(CreateDebtRequest request);
    [Throws=LedgeraEngineError]
    DebtPaymentDto register_debt_payment(RegisterDebtPaymentRequest request);
    [Throws=LedgeraEngineError]
    DebtPaymentDto register_debt_write_off(RegisterDebtPaymentRequest request);
    [Throws=LedgeraEngineError]
    DebtDto close_debt(RegisterDebtPaymentRequest request);
    [Throws=LedgeraEngineError]
    boolean delete_debt(i64 debt_id);
    [Throws=LedgeraEngineError]
    DebtDto delete_debt_payment(i64 payment_id, boolean delete_linked_record);
    [Throws=LedgeraEngineError]
    sequence<MandatoryTemplateDto> list_mandatory_templates();
    [Throws=LedgeraEngineError]
    MandatoryTemplateDto? get_mandatory_template(i64 template_id);
    [Throws=LedgeraEngineError]
    MandatoryTemplateDto create_mandatory_template(CreateMandatoryTemplateRequest request);
    [Throws=LedgeraEngineError]
    MandatoryTemplateDto update_mandatory_template(i64 template_id, UpdateMandatoryTemplateRequest request);
    [Throws=LedgeraEngineError]
    boolean delete_mandatory_template(i64 template_id);
    [Throws=LedgeraEngineError]
    i64 delete_all_mandatory_templates();
    [Throws=LedgeraEngineError]
    RecordDto add_mandatory_to_records(AddMandatoryToRecordsRequest request);
    [Throws=LedgeraEngineError]
    MandatoryAutoPayResultDto apply_mandatory_auto_payments(string today);
    [Throws=LedgeraEngineError]
    MandatoryImportResultDto preview_import_mandatory_csv(string path);
    [Throws=LedgeraEngineError]
    MandatoryImportResultDto import_mandatory_csv(string path);
    [Throws=LedgeraEngineError]
    MandatoryExportResultDto export_mandatory_csv(string path);
    [Throws=LedgeraEngineError]
    MandatoryImportResultDto preview_import_mandatory_xlsx(string path);
    [Throws=LedgeraEngineError]
    MandatoryImportResultDto import_mandatory_xlsx(string path);
    [Throws=LedgeraEngineError]
    MandatoryExportResultDto export_mandatory_xlsx(string path);
    [Throws=LedgeraEngineError]
    sequence<AuditFindingDto> audit_run();
    [Throws=LedgeraEngineError]
    sequence<WalletBalanceDto> wallet_balances();
    [Throws=LedgeraEngineError]
    WalletBalanceDto? wallet_balance(i64 wallet_id);
};
