namespace ledgera_engine {};

[Error]
enum LedgeraEngineError {
    "Validation",
    "Storage",
};

dictionary RecordFilterDto {
    string? start_date;
    string? end_date;
    i64? wallet_id;
    string? record_type;
};

dictionary CreateRecordRequest {
    string record_type;
    string date;
    i64 wallet_id;
    string amount_original;
    string currency;
    string rate_at_operation;
    string amount_base;
    string category;
    string description;
    sequence<string> tags;
};

dictionary UpdateRecordRequest {
    string record_type;
    string date;
    i64 wallet_id;
    string amount_original;
    string currency;
    string rate_at_operation;
    string amount_base;
    string category;
    string description;
    sequence<string> tags;
};

dictionary CreateTransferRequest {
    i64 from_wallet_id;
    i64 to_wallet_id;
    string date;
    string amount;
    string currency;
    string description;
    string commission_amount;
    string commission_currency;
};

dictionary CreateTransferResult {
    i64 transfer_id;
};

dictionary CurrencyTransferRequest {
    i64 from_wallet_id;
    i64 to_wallet_id;
    string date;
    string amount;
    string amount_currency;
    string description;
    string commission_amount;
    string commission_currency;
};

dictionary CurrencyTransferDto {
