    i64 exported_rows;
    string path;
};

dictionary AnalyticsFiltersDto {
    string period_start;
    string period_end;
    i64? wallet_id;
    string category;
    string tag;
    string tag_mode;
    string totals_mode;
    boolean group_by_category;
    string breakdown_mode;
    string pie_period;
    string daily_month;
    string monthly_year;
};

