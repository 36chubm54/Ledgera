    sequence<AnalyticsBreakdownRowDto> infographic_categories;
    sequence<AnalyticsMonthlyRowDto> monthly;
    sequence<AnalyticsDailyRowDto> daily;
    sequence<AnalyticsMonthlyRowDto> infographic_monthly;
