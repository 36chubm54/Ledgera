    string source_currency;
    string target_amount;
    string target_currency;
    string conversion_rate;
    string source_rate;
    string target_rate;
};

dictionary UpdateTransferRequest {
    i64 from_wallet_id;
    i64 to_wallet_id;
    string date;
    string amount;
    string currency;
    string description;
};

dictionary UpdateTransferResult {
    i64 transfer_id;
};

dictionary CreateWalletRequest {
    string name;
    string currency;
    string initial_balance;
    boolean allow_negative;
};

dictionary CurrencyRateDto {
    i64 id;
    string base_currency;
    string currency;
    string rate;
    string effective_date;
    string source;
    string created_at;
};

dictionary CurrencyRateRequest {
    string base_currency;
    string currency;
    string rate;
    string effective_date;
    string source;
};

dictionary CurrencyProviderConfig {
    string backend;
    string primary_provider;
    string fallback_provider;
    i64 timeout_seconds;
};

dictionary CurrencyRefreshRequest {
    string refresh_id;
    string backend;
    string base_currency;
    string primary_provider;
    string fallback_provider;
    string effective_date;
    string fetched_at;
    string provider_payload;
    string payload_format;
    string api_key;
    i64 timeout_seconds;
    boolean dry_run;
};

dictionary CurrencyRefreshResultDto {
    string refresh_id;
    string status;
    string selected_provider;
    i64 rates_count;
    string effective_date;
    string fetched_at;
    string fallback_chain;
    string diagnostic;
    boolean stale;
};

dictionary CurrencyRefreshStatusDto {
    string refresh_id;
    string backend;
    string requested_provider;
    string selected_provider;
    string status;
    string effective_date;
    string fetched_at;
    string fallback_chain;
    string diagnostic;
};

dictionary CurrencyProviderStatusDto {
    string name;
    boolean configured;
    boolean selected;
    string last_status;
    string diagnostic;
};

dictionary CurrencyRateSnapshotDto {
    i64 id;
    string refresh_id;
    string provider;
    string base_currency;
    string currency;
    string rate;
    string effective_date;
    string fetched_at;
    string status;
    string diagnostic;
};

dictionary CreateDebtRequest {
    string kind;
    string contact_name;
    i64 wallet_id;
    string amount;
    string currency;
    string created_at;
    string description;
};

dictionary RegisterDebtPaymentRequest {
