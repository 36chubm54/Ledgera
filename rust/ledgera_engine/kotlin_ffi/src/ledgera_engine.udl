    sequence<CapitalPointDto> capital;
    sequence<AssetBreakdownDto> asset_breakdown;
    sequence<AssetDto> assets;
    sequence<GoalDto> goals;
};

interface LedgeraEngine {
    constructor(string db_path);

    EngineStatusDto engine_status();
    [Throws=LedgeraEngineError]
    ReportResultDto generate_report(ReportFiltersDto filters);
    [Throws=LedgeraEngineError]
    ReportExportResultDto export_report_csv(ReportFiltersDto filters, string path);
    [Throws=LedgeraEngineError]
    ReportExportResultDto export_report_xlsx(ReportFiltersDto filters, string path);
    [Throws=LedgeraEngineError]
    ReportExportResultDto export_report_pdf(ReportFiltersDto filters, string path);
    [Throws=LedgeraEngineError]
    AnalyticsSnapshotDto generate_analytics_snapshot(AnalyticsFiltersDto filters);
    [Throws=LedgeraEngineError]
    DashboardDto dashboard_snapshot();
    [Throws=LedgeraEngineError]
    sequence<AssetDto> dashboard_assets(boolean active_only);
    [Throws=LedgeraEngineError]
    AssetDto dashboard_create_asset(string name, string category, string currency, string value, string snapshot_date, string description);
    [Throws=LedgeraEngineError]
    AssetDto dashboard_update_asset(i64 asset_id, string name, string category, string currency, string value, string snapshot_date, string description);
    [Throws=LedgeraEngineError]
    AssetDto dashboard_add_asset_snapshot(i64 asset_id, string value, string snapshot_date, string note);
    [Throws=LedgeraEngineError]
    sequence<AssetDto> dashboard_add_asset_snapshots(sequence<DashboardAssetSnapshotUpdate> updates, string snapshot_date);
    [Throws=LedgeraEngineError]
    AssetDto dashboard_set_asset_active(i64 asset_id, boolean active);
    [Throws=LedgeraEngineError]
    sequence<GoalDto> dashboard_goals();
    [Throws=LedgeraEngineError]
    GoalDto dashboard_create_goal(string title, string target_amount, string currency, string? target_date, string description);
    [Throws=LedgeraEngineError]
    void dashboard_set_goal_completed(i64 goal_id, boolean completed);
    [Throws=LedgeraEngineError]
    void dashboard_delete_goal(i64 goal_id);
    [Throws=LedgeraEngineError]
    sequence<string> list_analytics_categories(string period_start, string period_end);
    [Throws=LedgeraEngineError]
    sequence<string> list_analytics_tags(string period_start, string period_end);
    [Throws=LedgeraEngineError]
    sequence<string> list_analytics_months();
    [Throws=LedgeraEngineError]
    sequence<string> list_analytics_years();
    [Throws=LedgeraEngineError]
    string base_currency();
    [Throws=LedgeraEngineError]
    string set_base_currency(string currency);
    [Throws=LedgeraEngineError]
    sequence<string> supported_currencies();
    [Throws=LedgeraEngineError]
    sequence<CurrencyRateDto> currency_rates();
    [Throws=LedgeraEngineError]
    CurrencyRateDto upsert_currency_rate(CurrencyRateRequest request);
    [Throws=LedgeraEngineError]
    boolean delete_currency_rate(i64 rate_id);
    [Throws=LedgeraEngineError]
    CurrencyRefreshResultDto refresh_currency_rates(CurrencyRefreshRequest request);
    [Throws=LedgeraEngineError]
    CurrencyRefreshStatusDto currency_refresh_status();
    [Throws=LedgeraEngineError]
    sequence<CurrencyRateSnapshotDto> currency_rate_snapshots();
    [Throws=LedgeraEngineError]
    sequence<CurrencyProviderStatusDto> currency_provider_statuses();
    [Throws=LedgeraEngineError]
    sequence<RecordDto> list_records(RecordFilterDto filter);
    [Throws=LedgeraEngineError]
    RecordDto? get_record(i64 record_id);
    [Throws=LedgeraEngineError]
    RecordDto create_record(CreateRecordRequest request);
    [Throws=LedgeraEngineError]
    RecordDto create_record_with_tag_colors(CreateRecordRequest request, sequence<TagColorAssignment> tag_colors);
    [Throws=LedgeraEngineError]
    RecordDto update_record(i64 record_id, UpdateRecordRequest request);
    [Throws=LedgeraEngineError]
    RecordDto update_record_with_tag_colors(i64 record_id, UpdateRecordRequest request, sequence<TagColorAssignment> tag_colors);
    [Throws=LedgeraEngineError]
    boolean delete_record(i64 record_id);
    [Throws=LedgeraEngineError]
    CreateTransferResult create_transfer(CreateTransferRequest request);
    [Throws=LedgeraEngineError]
    CurrencyTransferDto create_currency_transfer(CurrencyTransferRequest request);
    [Throws=LedgeraEngineError]
    CurrencyTransferQuoteDto quote_currency_transfer(CurrencyTransferRequest request);
    [Throws=LedgeraEngineError]
    TransferDto? get_transfer(i64 transfer_id);
    [Throws=LedgeraEngineError]
    UpdateTransferResult update_transfer(i64 transfer_id, UpdateTransferRequest request);
    [Throws=LedgeraEngineError]
    boolean delete_transfer(i64 transfer_id);
    [Throws=LedgeraEngineError]
    OperationDeleteResultDto delete_all_operations();
    [Throws=LedgeraEngineError]
    OperationDeleteResultDto delete_operations_selection(sequence<i64> record_ids, sequence<i64> transfer_ids);
    [Throws=LedgeraEngineError]
    OperationImportResultDto preview_import_records_csv(string path);
    [Throws=LedgeraEngineError]
    OperationImportResultDto import_records_csv(string path);
    [Throws=LedgeraEngineError]
    OperationExportResultDto export_records_csv(string path);
    [Throws=LedgeraEngineError]
    OperationImportResultDto preview_import_records_xlsx(string path);
    [Throws=LedgeraEngineError]
    OperationImportResultDto import_records_xlsx(string path);
    [Throws=LedgeraEngineError]
    OperationExportResultDto export_records_xlsx(string path);
    [Throws=LedgeraEngineError]
    sequence<string> list_tags();
    [Throws=LedgeraEngineError]
    sequence<string> list_categories(string record_type);
    [Throws=LedgeraEngineError]
    sequence<string> list_record_descriptions(string? record_type);
    [Throws=LedgeraEngineError]
    OperationSuggestionsDto operation_suggestions();
    [Throws=LedgeraEngineError]
    sequence<TagColorDto> list_tag_colors();
    sequence<string> tag_color_palette();
    [Throws=LedgeraEngineError]
    void normalize_tag_colors();
    [Throws=LedgeraEngineError]
    sequence<WalletDto> list_wallets();
    [Throws=LedgeraEngineError]
    WalletDto set_system_wallet_initial_balance(string initial_balance);
    [Throws=LedgeraEngineError]
    WalletDto set_system_wallet_details(string name, string initial_balance);
    [Throws=LedgeraEngineError]
    WalletDto create_wallet(CreateWalletRequest request);
    [Throws=LedgeraEngineError]
    WalletDeleteResultDto delete_wallet(i64 wallet_id);
    [Throws=LedgeraEngineError]
    sequence<BudgetDto> list_budgets();
    [Throws=LedgeraEngineError]
    sequence<BudgetResultDto> list_budget_results(string? today);
    [Throws=LedgeraEngineError]
    BudgetDto create_budget(CreateBudgetRequest request);
    [Throws=LedgeraEngineError]
    BudgetDto update_budget_limit(i64 budget_id, string limit_base);
    [Throws=LedgeraEngineError]
    boolean delete_budget(i64 budget_id);
    [Throws=LedgeraEngineError]
    sequence<DistributionItemDto> distribution_items(boolean active_only);
    [Throws=LedgeraEngineError]
    sequence<DistributionSubitemDto> distribution_subitems(i64 item_id, boolean active_only);
    [Throws=LedgeraEngineError]
    DistributionItemDto distribution_create_item(CreateDistributionItemRequest request);
    [Throws=LedgeraEngineError]
    DistributionSubitemDto distribution_create_subitem(CreateDistributionSubitemRequest request);
    [Throws=LedgeraEngineError]
    DistributionItemDto distribution_update_item_pct(i64 item_id, double pct);
    [Throws=LedgeraEngineError]
    DistributionItemDto distribution_update_item(i64 item_id, string name, double pct);
    [Throws=LedgeraEngineError]
    DistributionSubitemDto distribution_update_subitem_pct(i64 subitem_id, double pct);
    [Throws=LedgeraEngineError]
    DistributionSubitemDto distribution_update_subitem(i64 subitem_id, string name, double pct);
    [Throws=LedgeraEngineError]
    DistributionItemDto distribution_update_item_name(i64 item_id, string name);
    [Throws=LedgeraEngineError]
    DistributionSubitemDto distribution_update_subitem_name(i64 subitem_id, string name);
    [Throws=LedgeraEngineError]
    void distribution_update_item_order(i64 item_id, i64 sort_order);
    [Throws=LedgeraEngineError]
    void distribution_update_subitem_order(i64 subitem_id, i64 sort_order);
    [Throws=LedgeraEngineError]
    void distribution_delete_item(i64 item_id);
    [Throws=LedgeraEngineError]
    void distribution_delete_subitem(i64 subitem_id);
    [Throws=LedgeraEngineError]
    sequence<DistributionValidationDto> distribution_validate();
    [Throws=LedgeraEngineError]
    DistributionMonthlyDto distribution_monthly(string month);
    [Throws=LedgeraEngineError]
    sequence<DistributionMonthlyDto> distribution_history(string start_month, string end_month);
    [Throws=LedgeraEngineError]
    sequence<string> distribution_available_months();
    [Throws=LedgeraEngineError]
    sequence<string> distribution_freeze_closed_months(string cutoff_month);
    [Throws=LedgeraEngineError]
    boolean distribution_is_month_fixed(string month);
    [Throws=LedgeraEngineError]
    boolean distribution_is_month_auto_fixed(string month);
    [Throws=LedgeraEngineError]
    DistributionFrozenRowDto distribution_freeze_month(string month, boolean auto_fixed);
    [Throws=LedgeraEngineError]
    void distribution_unfreeze_month(string month);
    [Throws=LedgeraEngineError]
    sequence<DistributionFrozenRowDto> distribution_frozen_rows(string? start_month, string? end_month);
